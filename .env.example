# Build-time configuration. Copy this file to .env, paste the anon key, then:
#
#   flutter run --dart-define-from-file=.env
#
# Every value here is compiled into the app and can be read by anyone who has
# the app. Do not add secrets (service role keys, third-party API keys).
# The Google Maps keys are configured separately, see the README.

# Production backend (HTTPS only; Android and iOS block plain http).
GRAPHQL_ENDPOINT=https://54.248.65.240/graphql
SUPABASE_URL=https://iwxbmaucxptwsvebpjxm.supabase.co
# Publishable (anon) key of that project:
# Supabase Dashboard -> Project Settings -> API keys. Never the service_role key.
SUPABASE_ANON_KEY=
# The free-form record flow is off for 1.0.
ENABLE_FREE_RECORD=false
# Only for a local backend started with AUTH_DISABLED=1:
# API_SEND_AUTH_HEADER=false
